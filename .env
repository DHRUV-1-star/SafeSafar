# SafeSafar - Maps API Key Configuration
# You can leave this blank to use the built-in free CartoDB / OpenStreetMap dark tiles
# Or paste your Mapbox public access token (pk.eyJ...) below for Mapbox Navigation Night tiles:
VITE_MAPBOX_TOKEN=

# OpenRouteService API Key (optional, for custom backend routing engine)
# Get a free key at: https://openrouteservice.org/dev/#/signup
VITE_OPENROUTESERVICE_KEY=
