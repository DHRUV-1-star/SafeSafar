# =============================================================================
# SafeSafar — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your real values.
#
# IMPORTANT: .env is in .gitignore and will NOT be committed.
# =============================================================================

# ── Mapbox Public Token ──────────────────────────────────────────────────────
# This is a PUBLIC / PUBLISHABLE token (starts with pk.).
# It is safe to bundle into the client-side JS build.
# Get a free token at: https://account.mapbox.com/auth/signup/
# After signup, copy the "Default public token" from your Mapbox dashboard.
VITE_MAPBOX_TOKEN=pk.eyJ1IjoieW91cl91c2VybmFtZSIsImEiOiJjbHR4eHh4eHkwMDAwMDNwYjAwMDBhYWFhIn0.REPLACE_ME

# ── Supabase Cloud Database & Authentication ─────────────────────────────────
# Get free project credentials at: https://supabase.com
# Run the SQL script from supabase_schema.sql in your Supabase SQL Editor.
# Copy your Project URL and anon public key from Project Settings > API:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ── Notes ────────────────────────────────────────────────────────────────────
# • If Supabase keys are empty, the app automatically runs in Local Database Mode
#   with persistent accounts and user-specific guardian records.
# • When Supabase is configured, all users and guardians are saved into PostgreSQL
#   with Row Level Security.
# • If VITE_MAPBOX_TOKEN is empty or missing, the app automatically falls back
#   to free CartoDB / OpenStreetMap tiles (no key required).
# • Do NOT add secret service_role keys — only use the publishable anon key.
